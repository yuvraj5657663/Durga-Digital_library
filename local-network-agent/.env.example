# Backend API URL (AWS production or local development)
BACKEND_URL=https://durgadigitallibrary.online

# Network Agent Credentials (must match server configuration)
AGENT_ID=durga-library-agent-001
AGENT_SECRET=your-secret-key-here-change-in-production

# Discovery interval in seconds
DISCOVERY_INTERVAL_SECONDS=30

# Local network subnet (optional, will auto-detect if not set)
LOCAL_SUBNET=192.168.1.0/24
