# ─────────────────────────────────────────────────────────────────────────────
# Durga Digital Library — Production Server .env
#
# USAGE ON EC2:
#   sudo cp server/.env.production server/.env
#   sudo nano server/.env            ← fill in real values
#   pm2 restart durga-library-server
#
# NEVER commit the filled-in .env to git.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# Bind to all interfaces so Nginx (on same machine) can proxy to it.
# If you set HOST=localhost or HOST=127.0.0.1 make sure nginx.conf also uses 127.0.0.1
HOST=0.0.0.0

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
MONGODB_URI=your_mongodb_atlas_uri_here

# ── JWT (must be 64+ hex chars in production) ──────────────────────────────
JWT_SECRET=your_jwt_secret_64chars_minimum_here
# JWT_EXPIRES_IN covers BOTH access and refresh fallback
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES=7d

# ── Admin credentials ──────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=your_strong_admin_password_here
ADMIN_EMAIL=admin@yourdomain.com

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password_16chars
EMAIL_FROM="Durga Digital Library <your_gmail@gmail.com>"

# ── CORS (comma-separated, no spaces) ─────────────────────────────────────
# Examples:
#   http://65.1.235.131          ← EC2 IP access (no domain yet)
#   https://yourdomain.com,https://www.yourdomain.com
# Leave empty to allow ALL origins (acceptable while testing on raw IP)
ALLOWED_ORIGINS=

# ── WhatsApp ───────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=false

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=Durga Digital Library
APP_URL=http://65.1.235.131

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ── Upload ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ── UPI / Payment ──────────────────────────────────────────────────────────
UPI_ID=your_upi_id_here
INQUIRY_LINK=https://forms.gle/HgSDtMLqnCZgreBe8
