# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/durga-library

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Admin Credentials (fallback - change in production)
ADMIN_USER=admin
ADMIN_PASS=change-this-password-in-production
ADMIN_EMAIL=admin@durga-library.local

# Email Configuration (Gmail SMTP)
# IMPORTANT: Use App Password, not regular password
# Get App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password-16chars
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM="Durga Digital Library <noreply@durgadigitallibrary.online>"

# WhatsApp Configuration
WHATSAPP_ENABLED=false
DISABLE_WHATSAPP=true

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=https://durgadigitallibrary.online,https://www.durgadigitallibrary.online

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Application
APP_NAME=Durga Digital Library
APP_URL=https://durgadigitallibrary.online

# Wi-Fi Configuration
MAX_WIFI_DEVICES_PER_STUDENT=2
WIFI_SESSION_DURATION_MINUTES=720

# Network Configuration
NETWORK_PORTAL_SESSION_DURATION_MINUTES=10
NETWORK_GATEWAY_MODE=production
NETWORK_GATEWAY_PROVIDER=mikrotik
NETWORK_GATEWAY_ID=
NETWORK_GATEWAY_HOST=
NETWORK_GATEWAY_PORT=
NETWORK_GATEWAY_USERNAME=
NETWORK_GATEWAY_PASSWORD=
NETWORK_GATEWAY_API_URL=
NETWORK_GATEWAY_API_USERNAME=
NETWORK_GATEWAY_API_PASSWORD=
NETWORK_ROUTER_VENDOR=
NETWORK_ROUTER_MODEL=
NETWORK_ROUTER_FIRMWARE=
NETWORK_GATEWAY_RADIUS_HOST=
NETWORK_GATEWAY_RADIUS_PORT=
NETWORK_GATEWAY_RADIUS_SECRET=
