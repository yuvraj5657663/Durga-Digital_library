# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
MONGODB_URI=mongodb://username:password@host:port/database

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Admin Credentials (fallback)
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_EMAIL=admin@durga-library.local

# Email Configuration (Gmail SMTP)
# IMPORTANT: Use App Password, not regular password
# Get App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password-16chars
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM="Durga Digital Library <noreply@durgadigitallibrary.online>"

# WhatsApp Configuration
DISABLE_WHATSAPP=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Application
APP_NAME=Durga Digital Library
APP_URL=http://localhost:3000

# Wi-Fi Configuration
MAX_WIFI_DEVICES_PER_STUDENT=2
WIFI_SESSION_DURATION_MINUTES=720

# Network Configuration
NETWORK_PORTAL_SESSION_DURATION_MINUTES=10
NETWORK_GATEWAY_MODE=development
NETWORK_GATEWAY_PROVIDER=development
NETWORK_GATEWAY_ID=
