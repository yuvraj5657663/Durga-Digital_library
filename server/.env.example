# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/durga-library

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Admin Credentials (fallback)
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_EMAIL=admin@durga-library.local

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=Durga Library <noreply@durgalibrary.com>

# WhatsApp Configuration
DISABLE_WHATSAPP=false

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Application
APP_NAME=Durga Digital Library
APP_URL=http://localhost:3000
